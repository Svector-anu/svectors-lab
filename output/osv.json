                },
                {
                  "type": "WEB",
                  "url": "https://rustsec.org/advisories/RUSTSEC-2023-0033.html"
                }
              ],
              "schema_version": "1.7.3",
              "summary": "Parsing borsh messages with ZST which are not-copy/clone is unsound"
            }
          ]
