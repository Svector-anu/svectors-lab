      "children": []
    },
    "stat-secrets": {
      "type": "Stat",
      "props": {
        "label": "Verified secrets",
        "value": "0",
        "delta": "filesystem + git history"
      },
      "children": []
    },
    "stat-cves": {
      "type": "Stat",
      "props": {
        "label": "OSV dependency CVEs",
        "value": "313",
        "delta": "all public, transitive-only"
      },
      "children": []
    },
    "text-crypto": {
      "type": "Text",
      "props": {
        "text": "Every crypto primitive — secp256k1, pbkdf2, elliptic, sha.js — is a transitive dependency, not directly bumpable.",
