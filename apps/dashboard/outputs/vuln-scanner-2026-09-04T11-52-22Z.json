{
  "root": "main_card",
  "state": {},
  "elements": {
    "main_card": {
      "type": "Card",
      "props": {
        "title": "vuln-scanner: honojs/hono"
      },
      "children": [
        "alert_clean",
        "stats_section",
        "separator_1",
        "scanners_section",
        "separator_2",
        "findings_section"
      ]
    },
    "alert_clean": {
      "type": "Alert",
      "props": {
        "type": "success",
        "message": "Clean audit. 4 semgrep + 43 osv rows + 5 agentic entrypoints reviewed, 0 confirmed."
      }
    },
    "stats_section": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "stat_semgrep",
        "stat_osv",
        "stat_agentic",
        "stat_confirmed"
      ]
    },
    "stat_semgrep": {
      "type": "Stat",
      "props": {
        "label": "Semgrep",
        "value": "4"
      }
    },
    "stat_osv": {
      "type": "Stat",
      "props": {
        "label": "OSV Rows",
        "value": "43"
      }
    },
    "stat_agentic": {
      "type": "Stat",
      "props": {
        "label": "Agentic Entrypoints",
        "value": "5"
      }
    },
    "stat_confirmed": {
      "type": "Stat",
      "props": {
        "label": "Confirmed Issues",
        "value": "0"
      }
    },
    "separator_1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "scanners_section": {
      "type": "Stack",
