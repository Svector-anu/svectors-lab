      ]
    },
    "scanners_heading": {
      "type": "Heading",
      "props": {
        "text": "Scanner Status",
        "level": "h3"
      }
    },
    "scanners_badges": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "sm"
      },
      "children": [
        "badge_semgrep",
        "badge_trufflehog",
        "badge_osv",
        "badge_fuzz",
        "badge_agentic"
      ]
    },
    "badge_semgrep": {
      "type": "Badge",
      "props": {
        "text": "semgrep=ok",
        "variant": "default"
      }
    },
    "badge_trufflehog": {
      "type": "Badge",
      "props": {
        "text": "trufflehog=ok",
        "variant": "default"
      }
    },
    "badge_osv": {
      "type": "Badge",
      "props": {
        "text": "osv=ok",
        "variant": "default"
      }
    },
    "badge_fuzz": {
      "type": "Badge",
      "props": {
        "text": "fuzz=skip",
        "variant": "secondary"
      }
    },
    "badge_agentic": {
      "type": "Badge",
      "props": {
        "text": "agentic=ok",
        "variant": "default"
      }
    },
    "separator_2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "findings_section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
