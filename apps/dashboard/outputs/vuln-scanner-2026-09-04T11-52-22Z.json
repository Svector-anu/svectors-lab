        "variant": "body"
      }
    },
    "finding_static": {
      "type": "Text",
      "props": {
        "text": "serve-static traversal guard held up on manual review.",
        "variant": "body"
      }
    },
    "finding_jsx": {
      "type": "Text",
      "props": {
        "text": "JSX streaming held up on manual review.",
        "variant": "body"
      }
    }
