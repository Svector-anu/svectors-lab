        ],
        "rows": [
          [
            "semgrep",
            "ok"
          ],
          [
            "trufflehog",
            "fail (no raw binary asset)"
          ],
          [
            "osv",
            "ok"
          ],
          [
            "fuzz",
            "n/a"
          ],
          [
            "agentic",
            "ok"
          ],
          [
            "PoC gate",
            "needs-verification"
          ]
        ]
      }
