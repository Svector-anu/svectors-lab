    "vuln-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "vuln-h2",
        "vuln-meta",
        "vuln-p1",
        "vuln-p2",
        "vuln-p3",
        "vuln-fix"
      ]
    },
    "vuln-h2": {
      "type": "Heading",
      "props": {
        "text": "XML Entity-Expansion DoS",
        "level": "h2"
      }
    },
    "vuln-meta": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "severity-badge",
        "tool-stat"
      ]
    },
    "severity-badge": {
      "type": "Badge",
      "props": {
        "text": "medium",
        "variant": "destructive"
      }
    },
    "tool-stat": {
      "type": "Text",
      "props": {
        "text": "watermarks-remover website-audit tool (Python, 8.7k★, commit 92f38b1)"
      }
    },
    "vuln-p1": {
      "type": "Text",
      "props": {
        "text": "\"Billion laughs\" DoS in service/scripts/audit_website.py:72 — parse_sitemap feeds a remote, attacker-controlled sitemap straight into xml.etree.ElementTree.fromstring, which expands internal DTD entities. A <1KB hostile sitemap inflates to gigabytes in memory → host DoS."
      }
    },
    "vuln-p2": {
      "type": "Text",
      "props": {
        "text": "Verified locally: 388 bytes → 3 MB (~7,700×) at just 7 entity levels; more levels go exponential. The 4 MB fetch cap is on input bytes, so it does nothing post-parse. This is the tool's core use case — auditing arbitrary untrusted sites — so the sitemap is fully attacker-controlled."
      }
    },
    "vuln-p3": {
      "type": "Text",
      "props": {
        "text": "Not XXE (etree doesn't fetch external entities), and not a duplicate: PR #49 hardened this same file against SSRF and gzip bombs but missed the XML bomb on the same parser."
      }
    },
    "vuln-fix": {
      "type": "Text",
      "props": {
        "text": "Fix is stdlib-only — reject DOCTYPE/entity declarations before parsing (sitemaps have none), or use defusedxml."
      }
    },
    "sep2": {
      "type": "Separator",
      "props": {}
    },
    "other-section": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
