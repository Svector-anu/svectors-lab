{
  "root": "main-card",
  "state": {},
  "elements": {
    "main-card": {
      "type": "Card",
      "props": {
        "title": "Vuln Scanner",
        "description": "cloudflare/workers-sdk"
      },
      "children": [
        "findings-stat",
        "sep1",
        "disclosure-stack",
        "sep2",
        "scanners-stack",
        "sep3",
        "triaged-stack"
      ]
    },
    "findings-stat": {
      "type": "Stat",
      "props": {
        "label": "Confirmed Findings",
        "value": "1",
        "delta": "Critical + High"
      }
    },
    "sep1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "disclosure-stack": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "disclosure-title",
        "pr-link",
