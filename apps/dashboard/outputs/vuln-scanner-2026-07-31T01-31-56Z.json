        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "watch-heading",
        "watch-stack",
        "watch-practices"
      ]
    },
    "watch-heading": {
      "type": "Heading",
      "props": {
        "text": "/watch skill",
        "level": "h3"
      }
    },
    "watch-stack": {
      "type": "Text",
      "props": {
        "text": "yt-dlp + ffmpeg + Whisper (~12.9k★)",
        "variant": "body"
      }
    },
    "watch-practices": {
      "type": "Text",
      "props": {
        "text": "Defensively coded: list-form subprocess, -- separators, - prefix rejection, path resolution",
        "variant": "caption"
      }
    },
    "separator3": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
