    "trufflehog-badge": {
      "type": "Badge",
      "props": {
        "text": "trufflehog: ok",
        "variant": "default"
      }
    },
    "osv-badge": {
      "type": "Badge",
      "props": {
        "text": "osv: ok",
        "variant": "default"
      }
    }
  }
}
