{
  "root": "main-card",
  "state": {},
  "elements": {
    "main-card": {
      "type": "Card",
      "props": {
        "title": "Vuln Scanner — bradautomates/claude-video"
      },
      "children": [
        "status-row",
        "separator1",
        "metrics",
        "separator2",
        "watch-details",
        "separator3",
        "findings",
        "separator4",
        "scanners"
      ]
    },
    "status-row": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "status-badge",
        "status-text"
      ]
    },
    "status-badge": {
      "type": "Badge",
      "props": {
        "text": "Clean",
        "variant": "default"
      }
    },
    "status-text": {
      "type": "Text",
      "props": {
        "text": "Clean audit",
        "variant": "body"
      }
    },
    "separator1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "metrics": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "lg"
      },
      "children": [
        "candidates-stat",
        "confirmed-stat"
      ]
    },
    "candidates-stat": {
      "type": "Stat",
      "props": {
        "label": "Candidates reviewed",
        "value": "3"
      }
    },
    "confirmed-stat": {
      "type": "Stat",
      "props": {
        "label": "Confirmed vulnerabilities",
        "value": "0"
      }
    },
    "separator2": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "watch-details": {
      "type": "Stack",
