    "gha-desc": {
      "type": "Text",
      "props": {
        "text": "Hardening nits",
        "variant": "caption"
      }
    },
    "urllib-item": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "md"
      },
      "children": [
        "urllib-badge",
        "urllib-desc"
      ]
