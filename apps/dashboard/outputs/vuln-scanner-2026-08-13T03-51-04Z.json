      "type": "Text",
      "props": {
        "text": "Joins a renderer-supplied filename into the default save dir with no .. or containment check on the silent first-save path.",
        "variant": "body"
      }
    },
    "impact-text": {
      "type": "Text",
      "props": {
        "text": "Impact: Arbitrary-path, arbitrary-content write",
        "variant": "lead"
      }
    },
    "handler-note": {
      "type": "Text",
      "props": {
        "text": "Sibling handlers (docs:save-as, slides) already validate — this one is the outlier.",
        "variant": "body"
      }
    },
    "risk-context": {
      "type": "Text",
      "props": {
        "text": "Not reachable from documents or the AI agent (current renderer callers all sanitize). Requires prior renderer-compromise, which the app's own sandbox model exists to contain. Framed as hardening/consistency fix.",
        "variant": "body"
      }
    },
