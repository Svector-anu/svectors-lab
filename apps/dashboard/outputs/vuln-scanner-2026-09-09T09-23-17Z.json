{
  "root": "card-main",
  "state": {},
  "elements": {
    "card-main": {
      "type": "Card",
      "props": {
        "title": "Vuln Scanner",
        "description": "NeoSoul-AI/evoevo-agent-kit"
      },
      "children": [
        "stack-main"
      ]
    },
    "stack-main": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "children": [
        "text-status",
        "stats-stack",
        "separator-1",
        "heading-scanners",
        "scanners-table"
      ]
    },
    "text-status": {
      "type": "Text",
      "props": {
        "text": "Clean audit",
        "variant": "lead"
      }
    },
    "stats-stack": {
      "type": "Stack",
      "props": {
        "direction": "horizontal",
        "gap": "lg"
      },
      "children": [
        "stat-candidates",
        "stat-confirmed"
      ]
    },
    "stat-candidates": {
      "type": "Stat",
      "props": {
        "label": "Candidates Reviewed",
        "value": "4"
      }
    },
    "stat-confirmed": {
      "type": "Stat",
      "props": {
        "label": "Vulnerabilities Confirmed",
        "value": "0"
      }
    },
    "separator-1": {
      "type": "Separator",
      "props": {
        "orientation": "horizontal"
      }
    },
    "heading-scanners": {
      "type": "Heading",
      "props": {
        "text": "Scanner Status",
        "level": "h3"
      }
    },
    "scanners-table": {
      "type": "Table",
      "props": {
        "columns": [
          "Scanner",
          "Status"
        ],
        "rows": [
          [
            "semgrep",
            "ok"
          ],
          [
            "trufflehog",
            "fail"
          ],
          [
            "trufflehog-git",
            "fail"
          ],
          [
            "osv",
            "none"
          ],
          [
            "fuzz",
            "skip"
          ],
          [
            "agentic",
            "ok"
          ]
        ]
      }
    }
  }
}
