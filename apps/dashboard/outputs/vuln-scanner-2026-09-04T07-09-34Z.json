      "type": "Text",
      "props": {
        "text": "PoC (benign control): 0 injected elements",
        "variant": "caption"
      }
    },
    "f1_poc_malicious": {
      "type": "Text",
      "props": {
        "text": "PoC (malicious): 1 live <img onerror> element. Reproduced with jsdom harness against literal shipped expression.",
        "variant": "caption"
      }
    },
