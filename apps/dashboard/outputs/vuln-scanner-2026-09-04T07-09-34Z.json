    "f1_title": {
      "type": "Heading",
      "props": {
        "text": "Finding 1: XSS via SVG Markup Injection",
        "level": "h3"
      }
    },
    "f1_severity": {
      "type": "Badge",
      "props": {
        "text": "HIGH (verified)",
        "variant": "destructive"
      }
    },
    "f1_file": {
      "type": "Text",
      "props": {
        "text": "apps/desktop/src/plugins/hermes-bots/avatar.tsx:212",
        "variant": "caption"
      }
    },
    "f1_desc": {
      "type": "Text",
      "props": {
        "text": "A remote group-chat participant's bot display name breaks out of an HTML attribute in string-built SVG markup. JSON.stringify does not neutralize \" for HTML context, allowing injection of a live DOM element with an executable event handler via dangerouslySetInnerHTML.",
        "variant": "body"
      }
    },
    "f1_poc": {
      "type": "Stack",
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
